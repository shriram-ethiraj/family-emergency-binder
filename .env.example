# Dedicated host directory containing the single encrypted database file.
# Docker Compose mounts this directory at /vault inside the container.
# Startup recursively normalizes ownership and permissions within this directory.
VAULT_DIR=./vault-data

# Dedicated host directory for generated password-protected PDFs.
OUTPUT_DIR=./output

# Dedicated directory for generated thumbnails and the template immutability manifest.
TEMPLATE_CACHE_DIR=./runtime-data/template-cache

# Node.js LTS version used by Docker Compose builds.
NODE_VERSION=24.21.0

PORT=4173
