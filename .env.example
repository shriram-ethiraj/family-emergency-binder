# Host directory containing the single encrypted database file.
# Docker Compose mounts this directory at /vault inside the container.
VAULT_DIR=./vault-data

# Host directory for generated password-protected PDFs.
OUTPUT_DIR=./output

# Generated template thumbnails and the local template immutability manifest.
TEMPLATE_CACHE_DIR=./runtime-data/template-cache

# Node.js LTS version used by Docker Compose builds.
NODE_VERSION=24.21.0

PORT=4173
